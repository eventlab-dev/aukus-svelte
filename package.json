{
  "name": "aukus",
  "private": true,
  "version": "1.0.64",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:prod": "cross-env VITE_BASE_URL=/ vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
